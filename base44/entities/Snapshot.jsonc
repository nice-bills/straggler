{
  "name": "Snapshot",
  "type": "object",
  "properties": {
    "repo_id": {
      "type": "string"
    },
    "commit_sha": {
      "type": "string"
    },
    "file_count": {
      "type": "integer"
    },
    "char_count": {
      "type": "integer"
    },
    "est_tokens": {
      "type": "integer"
    },
    "file_list": {
      "type": "string",
      "description": "JSON array of packed paths"
    },
    "packed_text_url": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "cut_count": {
      "type": "integer"
    },
    "cut_files": {
      "type": "string",
      "description": "JSON array of paths dropped at the 1.6M char cap"
    }
  },
  "required": [
    "repo_id",
    "commit_sha"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}