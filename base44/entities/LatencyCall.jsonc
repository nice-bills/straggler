{
  "name": "LatencyCall",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "idx": {
      "type": "integer"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "timeout"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ]
    },
    "http_code": {
      "type": "integer"
    },
    "model_returned": {
      "type": "string"
    },
    "headers_json": {
      "type": "string"
    },
    "in_tokens": {
      "type": "integer"
    },
    "out_tokens": {
      "type": "integer"
    },
    "tokens_per_sec": {
      "type": "number"
    },
    "cost_usd": {
      "type": "number"
    },
    "fallback_suspect": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "idx",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}